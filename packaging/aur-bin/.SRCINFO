pkgbase = gibson-screensaver-bin
	pkgdesc = Rust/wgpu recreation of the Gibson tower-city flythrough from Hackers (1995); prebuilt xscreensaver hack (host smoke-tested in CI on a software rasteriser, not on real hardware)
	pkgver = 2.1.0
	pkgrel = 1
	url = https://github.com/paulkiernan/gibson-screensaver
	install = gibson-screensaver-bin.install
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = gcc-libs
	depends = libx11
	depends = libxcb
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = vulkan-icd-loader
	optdepends = xscreensaver: run it as an xscreensaver hack (X11 only)
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = vulkan-nouveau: Vulkan driver for NVIDIA GPUs (Nouveau)
	optdepends = nvidia-utils: Vulkan driver for NVIDIA GPUs (proprietary)
	optdepends = vulkan-swrast: software Vulkan rasteriser (lavapipe), for machines with no GPU driver
	provides = gibson-screensaver
	conflicts = gibson-screensaver
	source = gibson-screensaver-linux-x86_64-2.1.0.tar.gz::https://github.com/paulkiernan/gibson-screensaver/releases/download/2.1.0/gibson-screensaver-linux-x86_64.tar.gz
	source = LICENSE-2.1.0::https://raw.githubusercontent.com/paulkiernan/gibson-screensaver/2.1.0/LICENSE
